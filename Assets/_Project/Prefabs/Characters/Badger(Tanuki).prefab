--- !u!114 &8206143513007199950
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5083728766813818154}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da22da9ef7f00ff4c95ac226046d2aa4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Benny Badger
  dialogueList:
  - characterName: Benny Badger
    characterAvatar: {fileID: -1153090657, guid: cf131c603455be243b2d00e30f2ff2c1, type: 3}
    sentence: '"Agent Pip! What are you doing here? Wow, perfect timing!"'
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: '"My radar picked up a suspicious signal around here, Benny."'
  - characterName: Benny Badger
    characterAvatar: {fileID: -1563780030, guid: cf131c603455be243b2d00e30f2ff2c1, type: 3}
    sentence: "\"Hehe, nothing really... It\u2019s just... I got a text saying I
      won $5,000 cash! I just have to click this link!\""
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: '"Oh gosh, Benny! Don''t do anything rash! Look at that URL, that''s
      definitely not an official site!!"'
  - characterName: Benny Badger
    characterAvatar: {fileID: 37159584, guid: cf131c603455be243b2d00e30f2ff2c1, type: 3}
    sentence: '"Uh... I-I don''t know, Agent Pip! I totally got blinded by the dollar
      signs... Help me double-check it, please?"'
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: "\"Okay, Let\u2019s go! Time to bust this scam right now!\""
  interactPrompt: {fileID: 7898150799477741497}
  movementScript: {fileID: 1376498760639736308}
  minigameSceneName: level1
