--- !u!114 &7520766426795222125
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4688131129148243426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da22da9ef7f00ff4c95ac226046d2aa4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Froggie
  dialogueList:
  - characterName: Froggie
    characterAvatar: {fileID: 2034647855, guid: 3ca2a75f604422f40a927669cfcfff9d, type: 3}
    sentence: "\"Agent Pip! Help! Your computer\u2014I mean, my computer is totally
      possessed by a virus!\" "
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: '"Good grief, Froggie! What did you do to get the screen flooded with
      malware and gambling pop-ups?!" '
  - characterName: Froggie
    characterAvatar: {fileID: 1225334639, guid: 3ca2a75f604422f40a927669cfcfff9d, type: 3}
    sentence: '"I just tried downloading a free game from a sketchy site, but everything
      froze and this weird window popped up!" '
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: '"What a mess! Hands off the keyboard and let me run a Device Scan
      right now!!" '
  interactPrompt: {fileID: 4590220097281778956}
  movementScript: {fileID: 6168120206510416298}
  minigameSceneName: level3
