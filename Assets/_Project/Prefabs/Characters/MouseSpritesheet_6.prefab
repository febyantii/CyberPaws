--- !u!114 &7292079889196438051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8269623994590542599}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: da22da9ef7f00ff4c95ac226046d2aa4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Macy Mouse
  dialogueList:
  - characterName: Macy Mouse
    characterAvatar: {fileID: -422759464, guid: 1b4563ed296f67f4dbdff25bc186d267, type: 3}
    sentence: '"Agent Pip?! Out of my way! My package is stuck, and the courier told
      me to download a tracking app right now!"'
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: '"Calm down, Macy! Read that text carefully. Downloading raw app files
      from a text message is a fast track to data theft!"'
  - characterName: Macy Mouse
    characterAvatar: {fileID: 318395790, guid: 1b4563ed296f67f4dbdff25bc186d267, type: 3}
    sentence: "\"Huh?! What do you mean? It\u2019s just a regular tracking file so
      my stuff arrives faster!\" "
  - characterName: Agent Pip
    characterAvatar: {fileID: 21300000, guid: c08fabe495670e24488e920ca9484d55, type: 3}
    sentence: "\"Don't let the file format fool you! Let\u2019s inspect the digital
      evidence together before hackers hijack your device.\"  "
  interactPrompt: {fileID: 2254965954571027152}
  movementScript: {fileID: 4107581326372635065}
  minigameSceneName: level2
