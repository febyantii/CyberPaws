  npcName: Benny Badger
  dialogueList:
  - characterName: Benny Badger
    characterAvatar: {fileID: 37159584, guid: cf131c603455be243b2d00e30f2ff2c1, type: 3}
    sentence: "\"Agent Pip! What are you doing here? Wow, perfect timing!\"\r"
  - characterName: Agent Pip
    characterAvatar: {fileID: -359497403, guid: 65e853737efa8784197367386bd38d49, type: 3}
    sentence: "\"My radar detected a suspicious signal anomaly around here, Benny.\"\r"
  - characterName: Benny badger
    characterAvatar: {fileID: -1563780030, guid: cf131c603455be243b2d00e30f2ff2c1, type: 3}
    sentence: "\"Hehe, oh, it's nothing... It's just... I recently got a text saying
      I won a $5,000 cash sweepstakes! I just have to click this link, but there
      are only 10 minutes left!.\"\r"
  - characterName: Agent Pip
    characterAvatar: {fileID: -359497403, guid: 65e853737efa8784197367386bd38d49, type: 3}
    sentence: "\"Hehe, oh, it's nothing... It's just... I recently got a text saying
      I won a $5,000 cash sweepstakes! I just have to click this link, but there
